# ---------------------------------------------------------------
# CivicSolve AI — environment variables (never commit real secrets)
# ---------------------------------------------------------------

# PostgreSQL (Spring Boot equivalents: SPRING_DATASOURCE_URL / DB_USERNAME / DB_PASSWORD)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AI provider (optional). Without a key the deterministic fallback engine is used.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Frontend (Vite equivalent: VITE_API_BASE_URL)
NEXT_PUBLIC_API_BASE_URL=/api
