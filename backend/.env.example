# CivicSolve AI — backend environment (Spring Boot equivalent names)
# In this repository the backend service layer runs inside the Next.js API layer
# (src/app/api + src/server). These variable names map 1:1 to a Spring Boot deployment.

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/app_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=604800000

# AI provider — leave AI_API_KEY empty to use the deterministic fallback engine
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
